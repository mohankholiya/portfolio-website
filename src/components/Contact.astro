---
import { siteConfig, copy } from "../content/site";
import Arrow from "./Arrow.astro";
const formKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY?.trim();
/* An unreplaced placeholder must never enable the form: it would render
   "Send enquiry" and then post to nothing, losing enquiries silently while
   looking like it worked. Web3Forms keys are UUIDs, so require that shape
   rather than blocklisting placeholder strings one at a time. */
const enabled = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(
  formKey ?? "",
);
const c = copy.contact;
---

<section
  id="contact"
  class="section contact-section"
  aria-labelledby="contact-heading"
>
  <div class="container contact-grid reveal">
    <div>
      <h2 class="multiline" id="contact-heading">
        {c.heading}
      </h2>
      <p class="contact-intro">{c.description}</p>
      <a class="contact-email" href={`mailto:${siteConfig.email}`}>
        {siteConfig.email}
        <Arrow />
      </a>
      <p class="contact-location">{c.location}</p>
      <a
        class="text-link"
        href={siteConfig.linkedin}
        target="_blank"
        rel="noopener noreferrer"
      >
        {c.linkedinLabel}
        <Arrow />
      </a>
    </div>
    <form
      method="post"
      action={`mailto:${siteConfig.email}`}
      enctype="text/plain"
      id="contact-form"
      class="contact-form"
      data-email={siteConfig.email}
      data-enabled={String(enabled)}
      data-sending={c.sending}
      data-prepared={c.prepared}
      data-success={c.success}
      data-error={c.error}
    >
      <h3>{c.formTitle}</h3>
      {enabled && <input type="hidden" name="access_key" value={formKey} />}
      <input
        type="hidden"
        name="subject"
        value="Portfolio enquiry — Mohan Kholiya"
      />
      <div class="honeypot" aria-hidden="true">
        <label>
          Leave this field empty
          <input type="text" name="botcheck" tabindex="-1" autocomplete="off" />
        </label>
      </div>
      <label for="contact-type">{c.labels.type}</label>
      <select id="contact-type" name="enquiry_type">
        {c.types.map((t) => (
          <option>{t}</option>
        ))}
      </select>
      <div class="form-row">
        <div>
          <label for="contact-name">{c.labels.name}</label>
          <input
            id="contact-name"
            name="name"
            required
            autocomplete="name"
            maxlength="100"
            placeholder={c.placeholders.name}
          />
        </div>
        <div>
          <label for="contact-email">{c.labels.email}</label>
          <input
            id="contact-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            maxlength="254"
            placeholder={c.placeholders.email}
          />
        </div>
      </div>
      <label for="contact-message">{c.labels.message}</label>
      <textarea
        id="contact-message"
        name="message"
        rows="4"
        required
        minlength="10"
        maxlength="5000"
        placeholder={c.placeholders.message}
      ></textarea>
      <p class="form-note">{enabled ? c.formHelp : c.emailHelp}</p>
      <button class="button" type="submit">
        <span>{enabled ? c.send : c.prepare}</span>
        <Arrow />
      </button>
      <p id="form-status" role="status" aria-live="polite"></p>
      <noscript>
        <style>
          #contact-form button[type="submit"] {
            display: none;
          }
        </style>
        <p>Please use the direct email link to contact Mohan.</p>
      </noscript>
    </form>
  </div>
</section>
<script>
  const form = document.querySelector<HTMLFormElement>("#contact-form");
  const type = document.querySelector<HTMLSelectElement>("#contact-type");
  const message =
    document.querySelector<HTMLTextAreaElement>("#contact-message");
  // Deep links from a case study carry the case headline so the enquiry
  // arrives with context already filled in. The enquiry type stays on its
  // default (an in-house leadership role) unless the visitor changes it.
  function populate() {
    const query = window.location.hash.split("?")[1];
    if (!query || !type || !message) return;
    const params = new URLSearchParams(query);
    const from = params.get("case");
    if (from && !message.value) {
      message.value = `I read the "${from}" case study. `;
    }
    document.getElementById("contact")?.scrollIntoView();
  }
  populate();
  window.addEventListener("hashchange", populate);
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;
    const data = new FormData(form);
    if (data.get("botcheck")) return;
    const status = document.querySelector<HTMLElement>("#form-status");
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]");
    if (!status || !button) return;
    if (form.dataset.enabled !== "true") {
      const subject = `${data.get("enquiry_type")} — ${data.get("name")}`;
      const body = `Name: ${data.get("name")}\nEmail: ${data.get("email")}\n\n${data.get("message")}`;
      window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      status.textContent = form.dataset.prepared ?? "";
      return;
    }
    button.disabled = true;
    const label = button.querySelector("span");
    const original = label?.textContent;
    if (label) label.textContent = form.dataset.sending ?? "Sending…";
    status.textContent = "";
    try {
      const payload = Object.fromEntries(data);
      delete payload.botcheck;
      const res = await fetch("https://api.web3forms.com/submit", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Accept: "application/json",
        },
        body: JSON.stringify(payload),
        signal: AbortSignal.timeout(15000),
      });
      const result = await res.json();
      if (!res.ok || !result.success) throw new Error("Delivery failed");
      status.textContent = form.dataset.success ?? "";
      form.reset();
    } catch {
      status.textContent = form.dataset.error ?? "";
    } finally {
      button.disabled = false;
      if (label) label.textContent = original ?? "";
    }
  });
</script>
