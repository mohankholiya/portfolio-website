---
import { services, copy } from "../content/site";
import Arrow from "./Arrow.astro";
---

<section
  id="capabilities"
  class="section"
  aria-labelledby="capabilities-heading"
>
  <div class="container">
    <div class="section-heading section-heading-stacked">
      <h2 class="multiline" id="capabilities-heading">
        {copy.capabilities.heading}
      </h2>
      <p>{copy.capabilities.description}</p>
    </div>
    <div class="service-grid reveal-group">
      {services.map((s) => (
        <article class="service-card reveal">
          <p class="service-question">{s.question}</p>
          <h3>{s.title}</h3>
          <p>{s.body}</p>
          <ul>
            {s.deliverables.map((d) => (
              <li>{d}</li>
            ))}
          </ul>
          <div class="service-links">
            <a class="text-link" href={`/case-studies/${s.caseId}/`}>
              {copy.capabilities.cta}
              <Arrow />
            </a>
          </div>
        </article>
      ))}
    </div>
    <div class="process reveal">
      <h3>{copy.capabilities.processTitle}</h3>
      <ol>
        {copy.capabilities.steps.map((s) => (
          <li>
            <h4>{s.title}</h4>
            <p>{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
