---
import { Picture } from "astro:assets";
import headshot from "../assets/headshot.jpeg";
import { siteConfig, copy } from "../content/site";
import Arrow from "./Arrow.astro";
---

<section id="about" class="section" aria-labelledby="about-heading">
  <div class="container">
    <div class="about-grid">
      <div class="about-portrait reveal">
        <Picture
          src={headshot}
          alt="Mohan Kholiya — Procurement &amp; Supply Chain Leader"
          width={480}
          height={480}
          widths={[240, 480]}
          sizes="240px"
          formats={["avif", "webp"]}
          loading="lazy"
        />
        <p class="portrait-name">{siteConfig.name}</p>
        <p>{siteConfig.location}</p>
        <a
          class="text-link"
          href={siteConfig.linkedin}
          target="_blank"
          rel="noopener noreferrer"
        >
          Connect on LinkedIn
          <Arrow />
        </a>
      </div>
      <div class="about-copy reveal">
        <h2 class="multiline" id="about-heading">
          {copy.about.heading}
        </h2>
        {copy.about.paragraphs.map((p) => (
          <p>{p}</p>
        ))}
        <div class="tools-note">
          <h3>{copy.about.toolsTitle}</h3>
          <p>{copy.about.toolsBody}</p>
          <a
            class="text-link"
            href={`mailto:${siteConfig.email}?subject=Procurement%20tools%20enquiry`}
          >
            {copy.about.toolsCta}
            <Arrow />
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
