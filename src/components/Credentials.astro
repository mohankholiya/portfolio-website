---
import { copy, credentials } from "../content/site";
---

<section
  class="section credentials-section"
  aria-label="Education and recognition"
>
  <div class="container">
    <div class="credentials" id="credentials">
      <h3>{copy.about.credentialsTitle}</h3>
      <div class="credentials-grid">
        {credentials.map((c) => (
          <div>
            <h4>{c.category}</h4>
            {c.entries.map((e) => (
              <div class="credential-item">
                <p class="credential-title">{e.title}</p>
                <p>{e.body}</p>
              </div>
            ))}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
