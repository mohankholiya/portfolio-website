---
import { siteConfig, copy } from "../content/site";
---

<footer class="site-footer">
  <div class="container footer-inner">
    <a class="brand" href="/">
      {siteConfig.name}
      <span aria-hidden="true">.</span>
    </a>
    <p>{copy.footer.tagline}</p>
    <div>
      <a href="/privacy/">{copy.footer.privacy}</a>
      <a href="#top">{copy.footer.back} ↑</a>
    </div>
    <span>
      © {new Date().getFullYear()} {copy.footer.copyright}
    </span>
  </div>
</footer>
