---
import MethodFigure from "./MethodFigure.astro";
interface Props {
  type: string;
}
const { type } = Astro.props;
const titles: Record<string, string> = {
  waterfall: "Negotiate the total cost, not only the headline rate.",
  governance: "A bounded opportunity, built from transaction-level evidence.",
  sourcing: "Three capital categories. One coordinated sourcing approach.",
  benchmark: "Broaden the peer set, then control for comparability.",
  capacity: "Workload and capacity must be assessed together.",
  categories: "One research framework. Two distinct sourcing strategies.",
};
---

<section
  id="analysis-exhibit"
  class="analysis-exhibit"
  aria-labelledby="exhibit-title"
>
  <div class="exhibit-header">
    <p class="eyebrow">Analytical exhibit</p>
    <h2 id="exhibit-title">{titles[type]}</h2>
  </div>
  {type === "waterfall" && (
    <>
      <div class="exhibit-split">
        <div class="exhibit-reading">
          <p class="exhibit-label">Reported commercial outcome</p>
          <p class="exhibit-value">~£2M</p>
          <p>Total-cost optimisation secured in the renewal.</p>
          <dl class="exhibit-facts">
            <div>
              <dt>Negotiating basis</dt>
              <dd>Should-cost and full-service economics</dd>
            </div>
            <div>
              <dt>Delivery constraint</dt>
              <dd>Protect field-service continuity</dd>
            </div>
            <div>
              <dt>Commercial outcome</dt>
              <dd>Incumbent retained</dd>
            </div>
          </dl>
        </div>
        <MethodFigure type="waterfall" />
      </div>
      <div class="decision-strip">
        <span>Decision rule</span>
        <p>
          Test rate reductions against mobilisation, travel, service levels and
          rework before judging the offer.
        </p>
      </div>
    </>
  )}
  {type === "governance" && (
    <>
      <div class="exhibit-split">
        <div class="exhibit-reading">
          <p class="exhibit-label">Assessment scope</p>
          <p class="exhibit-value">$233M</p>
          <p>Contractor programme spend assessed.</p>
          <dl class="exhibit-facts">
            <div>
              <dt>Transaction base</dt>
              <dd>Approximately 565,000 records</dd>
            </div>
            <div>
              <dt>Rate-code coverage</dt>
              <dd>482 codes</dd>
            </div>
            <div>
              <dt>Outcome stage</dt>
              <dd>Identified opportunity; implementation dependent</dd>
            </div>
          </dl>
        </div>
        <figure class="chart-sheet">
          <figcaption>
            What the opportunity is worth against the programme it sits in
            <span>Annual, $M. Both bars share one scale and start at zero.</span>
          </figcaption>
          <div
            class="exhibit-scroll"
            tabindex="0"
            role="region"
            aria-label="Identified opportunity against total programme spend"
          >
            {/* One measure, one axis. The comparison that matters to a reader
                is materiality: 4.9 to 6.0 against 233 is 2.1% to 2.6% of the
                programme, which is the number a client actually weighs. */}
            <svg
              viewBox="0 0 660 300"
              class="consulting-chart chart-animate bars-horizontal"
              role="img"
              aria-labelledby="opportunity-title opportunity-desc"
            >
              <title id="opportunity-title"
                >Identified opportunity of $4.9M to $6M per year against $233M of
                programme spend</title
              >
              <desc id="opportunity-desc">
                Two horizontal bars on a shared scale from zero to 240 million
                dollars. Programme spend assessed is 233 million. The identified
                annual opportunity runs from 4.9 to 6.0 million, which is 2.1 to
                2.6 percent of the programme. This is an assessment range, not
                realised savings and not a statistical confidence interval.
              </desc>

              {[0, 60, 120, 180, 240].map((v) => (
                <g>
                  <line
                    class="chart-grid"
                    x1={196 + (v / 240) * 400}
                    x2={196 + (v / 240) * 400}
                    y1="52"
                    y2="196"
                  />
                  <text x={196 + (v / 240) * 400} y="222" text-anchor="middle">
                    {v}
                  </text>
                </g>
              ))}

              <text class="chart-series-label" x="182" y="88" text-anchor="end">
                Programme assessed
              </text>
              <rect
                class="bar series-context"
                x="196"
                y="66"
                width={(233 / 240) * 400}
                height="36"
                rx="2"
              >
                <title>Programme spend assessed: $233M across 12 months</title>
              </rect>
              <text class="chart-value" x={196 + (233 / 240) * 400 + 12} y="92">
                233
              </text>

              <text
                class="chart-series-label"
                x="182"
                y="166"
                text-anchor="end"
              >
                Opportunity identified
              </text>
              {/* The range is drawn to scale. At this axis it is deliberately a
                  sliver: that honesty is the point of putting them together. */}
              <rect
                class="bar series-subject"
                x="196"
                y="144"
                width={Math.max((6 / 240) * 400, 4)}
                height="36"
                rx="2"
              >
                <title>Identified annual opportunity: $4.9M to $6.0M</title>
              </rect>
              <text class="chart-value" x="222" y="170">
                4.9 – 6.0
              </text>
              <text class="chart-caption" x="330" y="170">
                2.1% – 2.6% of programme spend
              </text>

              <line class="chart-baseline" x1="196" x2="596" y1="196" y2="196" />
              <text class="chart-caption" x="196" y="258">
                Identified opportunity against the assessment benchmark.
              </text>
              <text class="chart-caption" x="196" y="278">
                Not realised savings. Realisation depends on validation.
              </text>
            </svg>
          </div>
          <p class="exhibit-note">
            Percentages are derived from the two reported figures. The assessment
            uses a selected rate reference, which does not by itself establish an
            external market price.
          </p>
        </figure>
      </div>
      <div class="analysis-chain">
        <div>
          <span>01 / Make comparable</span>
          <strong>Work definition + unit of measure</strong>
        </div>
        <div>
          <span>02 / Size the exposure</span>
          <strong>Rate variance + contractor volume</strong>
        </div>
        <div>
          <span>03 / Change the contract</span>
          <strong>Scope clarity + billing rules</strong>
        </div>
      </div>
      <div class="decision-strip">
        <span>Decision rule</span>
        <p>
          Validate like-for-like work and the rate reference before converting
          an analytical opportunity into a negotiation target.
        </p>
      </div>
    </>
  )}
  {type === "benchmark" && (
    <>
      <div class="exhibit-split">
        <div class="exhibit-reading">
          <p class="exhibit-label">Peer-set construction</p>
          <p class="exhibit-value">27 projects</p>
          <p>In the expanded comparison set.</p>
          <dl class="exhibit-facts">
            <div>
              <dt>Coverage choice</dt>
              <dd>Broaden geographic inclusion</dd>
            </div>
            <div>
              <dt>Comparability controls</dt>
              <dd>Time, location and specification</dd>
            </div>
            <div>
              <dt>Decision use</dt>
              <dd>Set defensible targets by cost system</dd>
            </div>
          </dl>
        </div>
        <figure class="chart-sheet">
          <figcaption>
            Peer coverage expanded by nine projects{" "}
            <span>Number of peer projects</span>
          </figcaption>
          <div
            class="exhibit-scroll"
            tabindex="0"
            role="region"
            aria-label="Peer-set size comparison"
          >
            <svg
              viewBox="0 0 660 300"
              class="consulting-chart chart-animate bars-horizontal"
              role="img"
              aria-labelledby="peers-title peers-desc"
            >
              <title id="peers-title"
                >Peer-set expansion from 18 to 27 projects</title
              >
              <desc id="peers-desc">
                Two horizontal bars on a shared scale starting at zero. The
                initial regional set contains 18 projects. The expanded set
                contains 27 projects, nine more. This represents coverage of the
                comparison, not the performance of any project in it.
              </desc>
              {[0, 10, 20, 30].map((v) => (
                <g>
                  <line
                    class="chart-grid"
                    x1={196 + v * 13.5}
                    x2={196 + v * 13.5}
                    y1="48"
                    y2="206"
                  />
                  <text x={196 + v * 13.5} y="232" text-anchor="middle">
                    {v}
                  </text>
                </g>
              ))}
              <text class="chart-series-label" x="182" y="90" text-anchor="end">
                Initial regional set
              </text>
              <text
                class="chart-series-label"
                x="182"
                y="174"
                text-anchor="end"
              >
                Expanded peer set
              </text>
              <rect
                class="bar series-context"
                x="196"
                y="66"
                width={18 * 13.5}
                height="38"
                rx="2"
              >
                <title>Initial regional peer set: 18 projects</title>
              </rect>
              <rect
                class="bar series-subject"
                x="196"
                y="150"
                width={27 * 13.5}
                height="38"
                rx="2"
              >
                <title>Expanded peer set: 27 projects</title>
              </rect>
              <text class="chart-value" x={196 + 18 * 13.5 + 12} y="93">
                18
              </text>
              <text class="chart-value" x={196 + 27 * 13.5 + 12} y="177">
                27
              </text>
              {/* The delta is the decision, so it gets called out rather than
                  left for the reader to subtract. */}
              <line
                x1={196 + 18 * 13.5}
                x2={196 + 18 * 13.5}
                y1="150"
                y2="196"
                stroke="var(--chart-axis)"
                stroke-dasharray="3 3"
              />
              <text
                class="chart-caption"
                x={196 + 22.5 * 13.5}
                y="212"
                text-anchor="middle"
              >
                +9 projects
              </text>
              <line class="chart-baseline" x1="196" x2="600" y1="206" y2="206" />
              <text class="chart-caption" x="196" y="272">
                Coverage of the comparison set. Not a ranking, and not a measure
              </text>
              <text class="chart-caption" x="196" y="290">
                of any project's cost performance.
              </text>
            </svg>
          </div>
          <p class="exhibit-note">
            Counts reconstructed from the project snapshot. Broader coverage
            increases the importance of normalising differences; it does not
            prove comparability by itself.
          </p>
        </figure>
      </div>
      <div class="lens-comparison">
        <div>
          <span>Top-down / Project lens</span>
          <h3>Where is the cost gap?</h3>
          <p>Normalised peer comparisons by major cost system.</p>
        </div>
        <div>
          <span>Bottom-up / Component lens</span>
          <h3>What explains the gap?</h3>
          <p>
            Cost drivers, technical specifications and commercial assumptions.
          </p>
        </div>
      </div>
      <div class="decision-strip">
        <span>Decision rule</span>
        <p>
          Triangulate both lenses before proposing a target. First-quartile cost
          is not automatically achievable for every system.
        </p>
      </div>
    </>
  )}
  {type === "sourcing" && (
    <>
      <div class="sourcing-exhibit">
        <div class="sourcing-inputs">
          <p class="exhibit-label">Category scope</p>
          <div>EPC packages</div>
          <div>Surface facilities</div>
          <div>Drilling & completions</div>
        </div>
        <div class="sourcing-method">
          <p class="exhibit-label">Common sourcing discipline</p>
          <ol>
            <li>
              <strong>Aggregate demand</strong>
              <span>Coordinate requirements across projects.</span>
            </li>
            <li>
              <strong>Structure competition</strong>
              <span>Qualify suppliers, run RFx and evaluate total cost.</span>
            </li>
            <li>
              <strong>Negotiate and embed</strong>
              <span>Award packages and transfer category playbooks.</span>
            </li>
          </ol>
        </div>
        <div class="sourcing-outcome">
          <p class="exhibit-label">Reported portfolio outcome</p>
          <p class="exhibit-value">~$4M</p>
          <p>CapEx sourcing savings across the managed portfolio.</p>
          <span class="exhibit-note">
            No category-level savings allocation is implied.
          </span>
        </div>
      </div>
      <div
        class="exhibit-scroll"
        tabindex="0"
        role="region"
        aria-label="Sourcing decision criteria"
      >
        <table class="exhibit-table">
          <caption>Evaluation lens carried through to award</caption>
          <thead>
            <tr>
              <th scope="col">Cost</th>
              <th scope="col">Quality</th>
              <th scope="col">Schedule</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Comparable offers and total-cost exposure</td>
              <td>Technical compliance and supplier capability</td>
              <td>Delivery commitments and project requirements</td>
            </tr>
          </tbody>
        </table>
      </div>
      <div class="decision-strip">
        <span>Decision rule</span>
        <p>
          Coordinate demand at category level while tailoring the commercial
          approach to each supply market.
        </p>
      </div>
      <p class="exhibit-note">
        Method reconstruction from the engagement snapshot. Boxes represent
        categories and decisions, not spend proportions.
      </p>
    </>
  )}
  {type === "capacity" && (
    <>
      <div class="exhibit-split capacity-split">
        <div class="exhibit-reading">
          <p class="exhibit-label">Diagnostic framework</p>
          <h3>Separate utilisation from coverage.</h3>
          <p>
            Spend per person is one input. Interpret it alongside role scope,
            workload and service expectations.
          </p>
          <dl class="exhibit-facts">
            <div>
              <dt>Compare consistently</dt>
              <dd>Cluster roles by capability</dd>
            </div>
            <div>
              <dt>Look beyond headcount</dt>
              <dd>Check workload and functional ownership</dd>
            </div>
            <div>
              <dt>Frame the decision</dt>
              <dd>Capacity, role allocation or process design</dd>
            </div>
          </dl>
        </div>
        <figure class="capacity-map" tabindex="0" aria-label="Workload and available capacity decision map; scroll horizontally on small screens">
          <figcaption>
            Workload × available capacity <span>Qualitative decision map</span>
          </figcaption>
          <div class="capacity-axis">Available capacity: higher ↑</div>
          <div class="quadrant-grid">
            <div>
              <span>Higher capacity / Lower workload</span>
              <h3>Review role allocation</h3>
              <p>Check scope, duplication and redeployment options.</p>
            </div>
            <div>
              <span>Higher capacity / Higher workload</span>
              <h3>Test service adequacy</h3>
              <p>Check whether resources meet complexity and service needs.</p>
            </div>
            <div>
              <span>Lower capacity / Lower workload</span>
              <h3>Monitor coverage</h3>
              <p>Check specialist capability and resilience.</p>
            </div>
            <div class="quadrant-focus">
              <span>Lower capacity / Higher workload</span>
              <h3>Investigate constraints</h3>
              <p>Test capacity, prioritisation and process bottlenecks.</p>
            </div>
          </div>
          <div class="capacity-axis axis-bottom">Workload: lower → higher</div>
          <p class="exhibit-note">
            Illustrative assessment logic. No client teams, peer scores or
            measured staffing outcomes are plotted.
          </p>
        </figure>
      </div>
      <div class="decision-strip">
        <span>Decision rule</span>
        <p>
          A lean organisation and an overloaded organisation can have the same
          spend-per-FTE ratio. Test the context before recommending headcount
          changes.
        </p>
      </div>
    </>
  )}
  {type === "categories" && (
    <>
      <figure class="chart-sheet">
        <figcaption>
          Why one framework produces two different sourcing postures
          <span
            >Positioning follows from the cost and supply drivers in the table
            below. Analytical framework, not a market forecast.</span
          >
        </figcaption>
        <div
          class="exhibit-scroll"
          tabindex="0"
          role="region"
          aria-label="Category positioning matrix: supply-market concentration against engineering and lead-time intensity"
        >
          {/* A 2x2 is the right form here: the insight is relative position on
              two qualitative dimensions, not a magnitude. Axes are deliberately
              unnumbered because the underlying scores are qualitative. */}
          <svg
            viewBox="0 0 660 420"
            class="consulting-chart"
            role="img"
            aria-labelledby="cat-matrix-title cat-matrix-desc"
          >
            <title id="cat-matrix-title"
              >Category positioning: Lighting and E-STATCOM</title
            >
            <desc id="cat-matrix-desc">
              A two-by-two matrix. The horizontal axis runs from a fragmented to
              a concentrated supply market. The vertical axis runs from low to
              high engineering and lead-time intensity. Lighting sits in the
              lower left: a fragmented market with low engineering intensity,
              which supports competitive tendering. E-STATCOM sits in the upper
              right: a concentrated market with high engineering intensity,
              which supports a partnership posture with delivery guarantees.
              Positions are qualitative and follow from the cost drivers listed
              in the comparison table.
            </desc>

            <rect
              x="130"
              y="34"
              width="440"
              height="300"
              fill="var(--color-paper)"
            />
            <line
              class="chart-grid"
              x1="350"
              x2="350"
              y1="34"
              y2="334"
              stroke-dasharray="4 4"
            />
            <line
              class="chart-grid"
              x1="130"
              x2="570"
              y1="184"
              y2="184"
              stroke-dasharray="4 4"
            />

            {/* Quadrant names sit in the corners they describe. */}
            <text class="chart-caption" x="142" y="56">
              Competitive tendering
            </text>
            <text class="chart-caption" x="558" y="56" text-anchor="end">
              Partnership &amp; guarantees
            </text>

            {/* E-STATCOM: concentrated OEM market, engineered equipment.
                Labels sit directly under each marker so neither crosses the
                quadrant divider. */}
            <circle
              class="series-context"
              cx="462"
              cy="104"
              r="13"
              opacity="0.92"
            >
              <title
                >E-STATCOM: concentrated OEM market, engineered equipment with
                long-lead components</title
              >
            </circle>
            <text
              class="chart-series-label"
              x="462"
              y="142"
              text-anchor="middle"
            >
              E-STATCOM
            </text>
            <text class="chart-caption" x="462" y="162" text-anchor="middle">
              Engineered. Long-lead.
            </text>

            {/* Lighting: fragmented market, low engineering intensity. */}
            <circle
              class="series-subject"
              cx="232"
              cy="256"
              r="13"
              opacity="0.92"
            >
              <title
                >Lighting: fragmented OEM and distributor market, low
                engineering intensity</title
              >
            </circle>
            <text
              class="chart-series-label"
              x="232"
              y="294"
              text-anchor="middle"
            >
              Lighting
            </text>
            <text class="chart-caption" x="232" y="314" text-anchor="middle">
              Materials-led. Stocked.
            </text>

            <line class="chart-baseline" x1="130" x2="570" y1="334" y2="334" />
            <line class="chart-baseline" x1="130" x2="130" y1="34" y2="334" />
            <text class="chart-caption" x="350" y="360" text-anchor="middle">
              Supply market: fragmented → concentrated
            </text>
            <text
              class="chart-caption"
              x="116"
              y="184"
              text-anchor="middle"
              transform="rotate(-90 116 184)"
            >
              Engineering &amp; lead time: low → high
            </text>
            <text class="chart-caption" x="130" y="398">
              Qualitative positioning. Axes carry no numeric scale.
            </text>
          </svg>
        </div>
      </figure>
      <div
        class="exhibit-scroll"
        tabindex="0"
        role="region"
        aria-label="Lighting and E-STATCOM category comparison"
      >
        <table class="exhibit-table category-comparison">
          <caption>
            Category drivers translated into procurement questions
          </caption>
          <thead>
            <tr>
              <th scope="col">Decision dimension</th>
              <th scope="col">Lighting</th>
              <th scope="col">E-STATCOM</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">Supply-market lens</th>
              <td>OEM and distributor routes; supplier fragmentation</td>
              <td>OEM capabilities; technology and system requirements</td>
            </tr>
            <tr>
              <th scope="row">Cost-driver lens</th>
              <td>Materials, including copper; fixture specification</td>
              <td>
                Power electronics, engineered equipment and system content
              </td>
            </tr>
            <tr>
              <th scope="row">Lead-time lens</th>
              <td>Stocked versus non-stocked fixtures; replenishment</td>
              <td>
                Coupling transformers, power electronics and manufacturing
                capacity
              </td>
            </tr>
            <tr>
              <th scope="row">Commercial question</th>
              <td>
                Which supply route and stocking strategy fit the requirement?
              </td>
              <td>
                Which contracting structure and performance guarantees manage
                delivery risk?
              </td>
            </tr>
          </tbody>
        </table>
      </div>
      <div class="lens-comparison">
        <div>
          <span>Research input</span>
          <h3>Markets + internal spend</h3>
          <p>Supplier landscape, cost exposure and delivery constraints.</p>
        </div>
        <div>
          <span>Decision-support output</span>
          <h3>Two executive reports</h3>
          <p>A comparable structure with category-specific implications.</p>
        </div>
      </div>
      <div class="decision-strip">
        <span>Decision rule</span>
        <p>
          Use consistent research questions, then let each market's cost and
          supply drivers determine the sourcing implications.
        </p>
      </div>
      <p class="exhibit-note">
        Reconstructed from the category-report snapshot. This shows the
        engagement's analytical framework, not a current market forecast.
      </p>
    </>
  )}
</section>
