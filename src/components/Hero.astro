---
import { siteConfig, copy } from "../content/site";
import Arrow from "./Arrow.astro";
---

<section class="hero" aria-labelledby="hero-headline">
  <div class="container">
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{copy.hero.eyebrow}</p>
        <h1 id="hero-headline">{copy.hero.intro}</h1>
        <p class="hero-tagline">
          {copy.hero.first}
          <br />
          <span>{copy.hero.second}</span>
        </p>
        <p class="hero-intro">{siteConfig.positioning}</p>
        <div class="button-row">
          <a class="button" href="#experience">
            {copy.hero.primary}
            <Arrow />
          </a>
          <a class="text-link" href="#services">
            {copy.hero.secondary}
            <Arrow />
          </a>
        </div>
        <p class="hero-sectors">{copy.hero.footnote}</p>
      </div>
      <aside class="proof-panel" aria-label="Explore experience by audience">
        <div class="proof-top">
          <span class="eyebrow">{copy.proof.eyebrow}</span>
          <span aria-hidden="true" class="panel-monogram">
            MK
          </span>
        </div>
        <div
          class="audience-switch"
          role="group"
          aria-label="Choose your interest"
        >
          {copy.proof.panels.map((panel, i) => (
            <button
              type="button"
              data-audience={panel.id}
              aria-pressed={i === 0}
              aria-controls={`proof-${panel.id}`}
            >
              {copy.proof.labels[i]}
            </button>
          ))}
        </div>
        {copy.proof.panels.map((panel, i) => (
          <div
            class="proof-content"
            id={`proof-${panel.id}`}
            data-proof-panel={panel.id}
            hidden={i !== 0}
          >
            <h2>{panel.heading}</h2>
            <p>{panel.description}</p>
            <div class="proof-facts">
              {panel.facts.map((f) => (
                <a href={f.href}>
                  <strong>{f.value}</strong>
                  <span>{f.label}</span>
                  <Arrow />
                </a>
              ))}
            </div>
            <a class="proof-cta" href={panel.href}>
              {panel.cta}
              <Arrow />
            </a>
          </div>
        ))}
        <noscript>
          <style>
            .proof-content[hidden] {
              display: block !important;
            }
            .audience-switch {
              display: none !important;
            }
          </style>
        </noscript>
      </aside>
    </div>
    <div class="firm-strip">
      <span class="eyebrow">Experience across</span>
      <div>
        {copy.firms.map((f) => (
          <span>{f}</span>
        ))}
      </div>
    </div>
  </div>
</section>
<script>
  const buttons =
    document.querySelectorAll<HTMLButtonElement>("[data-audience]");
  const panels = document.querySelectorAll<HTMLElement>("[data-proof-panel]");
  buttons.forEach((b) =>
    b.addEventListener("click", () => {
      buttons.forEach((other) =>
        other.setAttribute("aria-pressed", String(other === b)),
      );
      panels.forEach(
        (p) => (p.hidden = p.dataset.proofPanel !== b.dataset.audience),
      );
    }),
  );
</script>
