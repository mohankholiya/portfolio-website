---
import CaseStudyLayout from "../layouts/CaseStudyLayout.astro";
import { caseStudies, copy } from "../content/site";
import CaseExhibits from "./CaseExhibits.astro";
import Arrow from "./Arrow.astro";
interface Props {
  id: string;
}
const cs = caseStudies.find((c) => c.id === Astro.props.id)!;
const next = caseStudies[(caseStudies.indexOf(cs) + 1) % caseStudies.length];
const c = copy.detail;
---

<CaseStudyLayout title={cs.headline} description={cs.description}>
  <section class="case-page-hero">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/case-studies/">← {c.back}</a>
      </nav>
      <p class="eyebrow">
        {cs.sectorLabel} / {c.eyebrow}
      </p>
      <h1>{cs.headline}</h1>
      <p class="case-lead">{cs.description}</p>
      {/* The same four facts the one-pager leads with. A recruiter scanning
          wants the shape of the engagement — who it was for, what the role
          actually was, and how long it ran — before the analysis. */}
      <div class="case-page-facts">
        <div>
          <span>{c.proof}</span>
          <strong>{cs.metric}</strong>
          <p>{cs.metricLabel}</p>
        </div>
        <div>
          <span>{c.scope}</span>
          <p>{cs.scope}</p>
        </div>
        <div>
          <span>{c.engagementRole}</span>
          <p>{cs.engagementRole}</p>
        </div>
        <div>
          <span>{c.duration}</span>
          <p>{cs.duration}</p>
        </div>
      </div>
    </div>
  </section>
  <div id="analysis-exhibit" class="container exhibit-container">
    <CaseExhibits id={cs.id} />
  </div>
  <div class="container detail-grid">
    <nav class="detail-toc" aria-label="On this page">
      <p class="eyebrow">Inside the case</p>
      <a href="#analysis-exhibit">{c.exhibits}</a>
      <a href="#challenge">{c.challenge}</a>
      <a href="#contribution">{c.role}</a>
      <a href="#approach">{c.approach}</a>
      <a href="#judgment">{c.judgment}</a>
      <a href="#results">{c.results}</a>
      <a href="#case-enquiry">{c.cta}</a>
    </nav>
    <div class="detail-body">
      <section id="challenge" class="detail-section">
        <h2>{c.challenge}</h2>
        <p>{cs.challenge}</p>
      </section>
      <section id="contribution" class="detail-section">
        <h2>{c.role}</h2>
        <p>{cs.role}</p>
      </section>
      <section id="approach" class="detail-section">
        <h2>{c.approach}</h2>
        <ol class="approach-list">
          {cs.approach.map((s) => (
            <li>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </li>
          ))}
        </ol>
      </section>
      <section id="judgment" class="detail-section judgment">
        <h2>{c.judgment}</h2>
        <p>{cs.judgment}</p>
      </section>
      <section id="results" class="detail-section">
        <h2>{c.results}</h2>
        <ul class="result-list">
          {cs.results.map((r) => (
            <li>{r}</li>
          ))}
        </ul>
        <p class="case-note">{cs.note}</p>
      </section>
      {/* Offered after the results rather than in the header: a reader who has
          finished the case is the one who wants to forward it. */}
      <a
        class="resume-card case-onepager reveal"
        href={`/case-studies/${cs.id}.pdf`}
        download
      >
        <div>
          <span class="eyebrow">{c.onePagerNote}</span>
          {/* h3, not h4: the previous heading on this page is the h2 on the
              results section, and skipping a level fails heading-order. */}
          <h3>{c.onePagerTitle}</h3>
          <p>{c.onePagerBody}</p>
          <span class="resume-cta">{c.onePagerLabel}</span>
        </div>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M12 3v12m-5-5 5 5 5-5M4 16v5h16v-5"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </a>
    </div>
  </div>
  <section id="case-enquiry" class="case-cta">
    <div class="container">
      <div class="case-cta-inner">
        <div>
          <h2>{c.ctaHeading}</h2>
          <p>{c.ctaBody}</p>
        </div>
        <a
          class="button button-light"
          href={`/#contact?case=${encodeURIComponent(cs.headline)}`}
        >
          {c.cta}
          <Arrow />
        </a>
      </div>
      <div class="next-case">
        <span>{c.next}</span>
        <a href={`/case-studies/${next.id}/`}>
          {next.headline} <Arrow />
        </a>
      </div>
    </div>
  </section>
</CaseStudyLayout>
