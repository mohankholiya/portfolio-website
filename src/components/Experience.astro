---
import { experience, copy } from "../content/site";
---

<section
  id="experience"
  class="section section-tint"
  aria-labelledby="experience-heading"
>
  <div class="container">
    <div class="section-heading reveal">
      <div>
        <p class="eyebrow">{copy.experience.eyebrow}</p>
        <h2 class="multiline" id="experience-heading">
          {copy.experience.heading}
        </h2>
      </div>
      <p>{copy.experience.description}</p>
    </div>
    {/* The rail is a sibling of the list rather than a child, because an <ol>
        may only contain <li> and a decorative <div> inside it is invalid. The
        wrapper is the positioning context for both the rail and the per-role
        nodes, which are absolutely positioned out of each <li>. */}
    <div class="career-timeline">
      <div class="career-rail" aria-hidden="true">
        <div class="career-rail-fill"></div>
      </div>
      <ol class="career-list reveal-group">
      {experience.map((job) => (
        <li class="reveal">
          <span class="career-node" aria-hidden="true">
            <span class="career-node-dot"></span>
          </span>
          <div class="career-period">
            <span>{job.period}</span>
            <span
              class:list={[
                "career-type",
                { "consulting-type": job.type === "Consulting" },
              ]}
            >
              {job.type}
            </span>
          </div>
          <div class="career-main">
            <h3>{job.company}</h3>
            <p class="career-role">{job.role}</p>
            <p>{job.summary}</p>
          </div>
          <ul class="career-highlights">
            {job.highlights.map((h) => (
              <li>{h}</li>
            ))}
          </ul>
        </li>
      ))}
      </ol>
    </div>
    <div id="resumes" class="resume-section reveal">
      <h3>{copy.experience.downloadsTitle}</h3>
      <p>{copy.experience.downloadsBody}</p>
      <div class="resume-grid">
        {copy.experience.downloads.map((d) => (
          <a class="resume-card reveal" href={d.href} download>
            <div>
              <span class="eyebrow">{d.note}</span>
              <h4>{d.title}</h4>
              <p>{d.body}</p>
              <span class="resume-cta">{d.label}</span>
            </div>
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M12 3v12m-5-5 5 5 5-5M4 16v5h16v-5"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>
