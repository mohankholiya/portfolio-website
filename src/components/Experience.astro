---
import { experience, copy } from "../content/site";
---

<section
  id="experience"
  class="section section-tint"
  aria-labelledby="experience-heading"
>
  <div class="container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">{copy.experience.eyebrow}</p>
        <h2 class="multiline" id="experience-heading">
          {copy.experience.heading}
        </h2>
      </div>
      <p>{copy.experience.description}</p>
    </div>
    <ol class="career-list">
      {experience.map((job) => (
        <li>
          <div class="career-period">
            <span>{job.period}</span>
            <span
              class:list={[
                "career-type",
                { "consulting-type": job.type === "Consulting" },
              ]}
            >
              {job.type}
            </span>
          </div>
          <div class="career-main">
            <h3>{job.company}</h3>
            <p class="career-role">{job.role}</p>
            <p>{job.summary}</p>
          </div>
          <ul class="career-highlights">
            {job.highlights.map((h) => (
              <li>{h}</li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
    <div id="resumes" class="resume-section">
      <h3>{copy.experience.downloadsTitle}</h3>
      <p>{copy.experience.downloadsBody}</p>
      <div class="resume-grid">
        {copy.experience.downloads.map((r) => (
          <a class="resume-card" href={r.href} download>
            <div>
              <span class="eyebrow">{copy.experience.downloadNote}</span>
              <h4>{r.title}</h4>
              <p>{r.body}</p>
              <span class="resume-cta">{r.label}</span>
            </div>
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M12 3v12m-5-5 5 5 5-5M4 16v5h16v-5"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>
