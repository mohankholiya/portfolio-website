---
import { copy } from "../content/site";
import Arrow from "./Arrow.astro";
interface Props {
  id: string;
  sector: string;
  sectorLabel: string;
  headline: string;
  metric: string;
  metricLabel: string;
  /* The card takes `summary`, not `description` — see the note in
     src/content/site.ts. `description` is still spread in from the same
     object, so it is declared here to keep the props typed. */
  summary: string;
  description: string;
  tags: string[];
  status: string;
  index: number;
}
const cs = Astro.props;

/* One grammar across all six sparks: copper is always the finding, petrol is
   always the context it sits inside, hairline is scaffolding. Every figure
   below is either stated in that case study or derived from two figures that
   are. Where a case has no defensible ratio, the spark shows the shape of the
   analysis instead of inventing a proportion. */
const A = "var(--series-subject)";
const C = "var(--series-context)";
const H = "var(--color-hairline)";
const F = "var(--color-muted)";
const MONO = "var(--font-mono)";

const label = (x: number, y: number, s: string, fill = F, anchor = "start") =>
  `<text x="${x}" y="${y}" font-family="${MONO}" font-size="9.5" fill="${fill}" text-anchor="${anchor}">${s}</text>`;

const sparks: Record<string, string> = {
  // The bridge from quote to signed contract. Three named reductions sum to
  // ~£2M; widths are proportional to the £0.9M / £0.6M / £0.5M split stated
  // in the case, so the rate gap reads as under half the outcome.
  "bt-contract-renewal": `
    <svg viewBox="0 0 280 54" role="img" aria-label="Roughly two million pounds of optimisation from three levers: the rate gap, travel and mobilisation, and service levels and rework">
      ${label(0, 10, "Levers beyond the headline rate")}
      <rect x="0" y="19" width="116" height="12" rx="2" fill="${A}"/>
      <rect x="121" y="19" width="77" height="12" rx="2" fill="${A}" opacity="0.72"/>
      <rect x="203" y="19" width="65" height="12" rx="2" fill="${A}" opacity="0.5"/>
      ${label(0, 46, "Rate gap")}
      ${label(121, 46, "Travel")}
      ${label(203, 46, "SLA / rework")}
    </svg>`,

  // ~6 of ~230 is about 2.6%. Drawn to scale, which is the honest picture.
  "unit-rate-governance": `
    <svg viewBox="0 0 280 54" role="img" aria-label="Identified opportunity of about five to six million dollars against a programme of about 230 million dollars, roughly two and a half percent">
      ${label(0, 10, "Opportunity against programme spend")}
      <rect x="0" y="19" width="268" height="12" rx="2" fill="${C}" opacity="0.28"/>
      <rect x="0" y="19" width="${(6 / 230) * 268}" height="12" rx="2" fill="${A}"/>
      ${label(0, 46, "~$5–6M identified", A)}
      ${label(268, 46, "of ~$230M", F, "end")}
    </svg>`,

  // Three categories coordinated; savings are portfolio-level only, so the
  // category blocks are drawn as outlines and carry no share of the total.
  "accenture-capex-sourcing": `
    <svg viewBox="0 0 280 58" role="img" aria-label="Three capital categories coordinated under one sourcing approach, with portfolio savings of about four million dollars and no category split implied">
      ${label(1, 10, "Three categories, one approach")}
      ${["EPC", "Surface", "D&C"]
        .map(
          (t, i) =>
            `<rect x="${i * 93}" y="16" width="84" height="16" rx="2" fill="none" stroke="${H}"/>` +
            `<text x="${i * 93 + 42}" y="27" font-family="${MONO}" font-size="9" fill="${F}" text-anchor="middle">${t}</text>`,
        )
        .join("")}
      <rect x="0" y="37" width="268" height="5" rx="2" fill="${A}"/>
      ${label(0, 54, "~$4M across the portfolio", A)}
      ${label(268, 54, "no split implied", F, "end")}
    </svg>`,

  // Peer-set coverage, 18 expanded to 27. Both bars share one scale.
  "capital-cost-competitiveness": `
    <svg viewBox="0 0 280 54" role="img" aria-label="Peer set expanded from 18 projects to 27 projects">
      ${label(0, 10, "Peer-set coverage")}
      <rect x="66" y="15" width="${18 * 7.4}" height="11" rx="2" fill="${C}" opacity="0.55"/>
      <rect x="66" y="30" width="${27 * 7.4}" height="11" rx="2" fill="${A}"/>
      ${label(60, 24, "18", F, "end")}
      ${label(60, 39, "27", A, "end")}
      ${label(0, 52, "Regional set expanded by nine projects")}
    </svg>`,

  // The finding in one line: all four core roles sit at or above the peer upper
  // quartile. The box is the peer interquartile range, the diamonds this utility.
  "supply-chain-benchmarking": `
    <svg viewBox="0 0 280 54" role="img" aria-label="All four core supply-chain roles sit at or above the peer upper quartile for spend supported per full-time equivalent">
      ${label(0, 10, "Spend per FTE vs the peer range")}
      <line x1="12" y1="27" x2="200" y2="27" stroke="${H}"/>
      <rect x="54" y="20" width="84" height="15" fill="${C}" opacity="0.2" stroke="${H}"/>
      <line x1="96" y1="20" x2="96" y2="35" stroke="${C}"/>
      ${[152, 166, 180, 194]
        .map((x) => `<path d="M${x} 21 l6 6 -6 6 -6 -6 z" fill="${A}"/>`)
        .join("")}
      ${label(0, 50, "Peer interquartile range")}
      ${label(268, 50, "4 of 4 roles above Q3", A, "end")}
    </svg>`,

  // E-STATCOM only. Power semiconductors (30%) plus coupling transformer and
  // magnetics (24%) are ~54% of installed cost, and both are supply-constrained.
  "category-intelligence": `
    <svg viewBox="0 0 280 54" role="img" aria-label="Power semiconductors and coupling transformer and magnetics are together about 54 percent of installed E-STATCOM cost, and both are supply-constrained">
      ${label(0, 10, "What moves E-STATCOM price")}
      <rect x="0" y="19" width="${268 * 0.3}" height="12" rx="2" fill="${A}"/>
      <rect x="${268 * 0.3 + 2}" y="19" width="${268 * 0.24 - 2}" height="12" rx="2" fill="${A}" opacity="0.66"/>
      <rect x="${268 * 0.54 + 2}" y="19" width="${268 * 0.46 - 2}" height="12" rx="2" fill="${C}" opacity="0.28"/>
      ${label(0, 46, "Semiconductors + magnetics", A)}
      ${label(268, 46, "~54% of cost", F, "end")}
    </svg>`,
};
---

<article class:list={["case-card", "reveal", { "case-card-featured": cs.index === 0 }]}>
  <div class="case-meta">
    <span>{cs.sectorLabel}</span>
    <span aria-hidden="true">{String(cs.index + 1).padStart(2, "0")}</span>
  </div>
  <div class="case-result">
    <strong>{cs.metric}</strong>
    <p>{cs.metricLabel}</p>
  </div>
  <span class="outcome-label">{cs.status}</span>
  <div class="case-spark" set:html={sparks[cs.id] ?? ""}></div>
  <h3>
    <a href={`/case-studies/${cs.id}/`}>{cs.headline}</a>
  </h3>
  <p class="case-description">{cs.summary}</p>
  <div class="case-bottom">
    <span>{cs.tags[0]}</span>
    <a
      href={`/case-studies/${cs.id}/`}
      aria-label={`${copy.cases.read}: ${cs.headline}`}
    >
      {copy.cases.read}
      <Arrow />
    </a>
  </div>
</article>
