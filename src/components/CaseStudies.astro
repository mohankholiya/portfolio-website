---
import { caseStudies, copy } from "../content/site";
import CaseStudyCard from "./CaseStudyCard.astro";
import Arrow from "./Arrow.astro";
---

<section
  id="case-studies"
  class="section section-tint"
  aria-labelledby="work-heading"
>
  <div class="container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">{copy.cases.eyebrow}</p>
        <h2 id="work-heading">{copy.cases.heading}</h2>
      </div>
      <p>{copy.cases.description}</p>
    </div>
    <div class="case-grid">
      {caseStudies.slice(0, 3).map((cs, index) => (
        <CaseStudyCard {...cs} index={index} />
      ))}
    </div>
    <div class="section-end">
      <span>Consulting & in-house engagements</span>
      <a href="/case-studies/" class="text-link">
        {copy.cases.more}
        <Arrow />
      </a>
    </div>
  </div>
</section>
