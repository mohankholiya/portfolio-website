---
import "../styles/global.css";
import "../styles/exhibits.css";
import { siteConfig } from "../content/site";
interface Props {
  title?: string;
  description?: string;
}
const { title = siteConfig.title, description = siteConfig.description } =
  Astro.props;
const is404 = Astro.url.pathname.replace(/\/$/, "") === "/404";
const canonical = new URL(
  is404 ? "/404.html" : Astro.url.pathname,
  siteConfig.url,
).href;
const ogImage = new URL("/og-image.png", siteConfig.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Mohan Kholiya, procurement and supply chain leadership. 16+ years across energy, utilities and telecom."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {is404 && <meta name="robots" content="noindex" />}
    {/* Only the faces that paint above the fold are preloaded. The serif sets
        the hero tagline and every h1/h2, so it is the LCP face and goes first.
        Plex Mono carries small labels, where a swap is not worth another
        blocking request on a 4G connection. */}
    <link
      rel="preload"
      href="/fonts/source-serif-4-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/archivo-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/source-sans-3-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        name: siteConfig.name,
        url: siteConfig.url,
        jobTitle: "Procurement & Supply Chain Leader",
        description: siteConfig.description,
        sameAs: [siteConfig.linkedin],
        image: `${siteConfig.url}/images/headshot.jpeg`,
        knowsAbout: [
          "Strategic sourcing",
          "Procurement transformation",
          "Capital benchmarking",
          "Category strategy",
          "Supplier governance",
        ],
        alumniOf: [
          {
            "@type": "CollegeOrUniversity",
            name: "University of Petroleum & Energy Studies",
          },
          { "@type": "CollegeOrUniversity", name: "Kumaun University" },
        ],
      }).replace(/</g, "\u003c")}
    ></script>
  </head>
  <body>
    {/* Set before paint so the reveal styles never flash content in and out,
        and so a no-JS visitor gets the fully visible page.

        `motion` records that this visitor may have motion — JS is on and they
        have not asked for reduced motion. It gates the loader in
        src/scripts/motion-entry.ts, which decides *when* to fetch GSAP.

        There is deliberately no watchdog. No stylesheet rule hides anything on
        the strength of these classes: the motion module sets its own start
        states in JS immediately before animating them. A page where the bundle
        never arrives, arrives late, or throws is simply a page without
        animation — never a page with an invisible chart on it. */}
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add("js");
        if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
          root.classList.add("motion");
        }
      })();
    </script>
    <a class="skip-link" href="#main-content">
      Skip to main content
    </a>
    <slot />
    <script>
      // IntersectionObserver only. No scroll listener anywhere on this site.
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");

      function activate() {
        const targets = document.querySelectorAll<HTMLElement>(
          ".reveal, .chart-animate",
        );
        if (reduce.matches || !("IntersectionObserver" in window)) {
          targets.forEach((el) => el.classList.add("is-in"));
          return;
        }

        // Stagger siblings inside a group so a grid arrives as a wave rather
        // than all at once. Capped so a long list never crawls in.
        document.querySelectorAll(".reveal-group").forEach((group) => {
          Array.from(group.children).forEach((child, i) => {
            (child as HTMLElement).style.setProperty(
              "--reveal-delay",
              `${Math.min(i, 5) * 0.07}s`,
            );
          });
        });

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add("is-in");
              observer.unobserve(entry.target); // reveal once, never replay
            });
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.12 },
        );

        targets.forEach((el) => observer.observe(el));
      }

      activate();
    </script>
    {/* Loader only (<1KB). It dynamic-imports the real motion bundle once the
        page is idle or the visitor moves to scroll, which keeps ~51KB of GSAP
        and Lenis off the critical path. */}
    <script>
      import "../scripts/motion-entry";
    </script>
  </body>
</html>
