---
import "../styles/global.css";
import "../styles/exhibits.css";
import { siteConfig } from "../content/site";
interface Props {
  title?: string;
  description?: string;
}
const { title = siteConfig.title, description = siteConfig.description } =
  Astro.props;
const is404 = Astro.url.pathname.replace(/\/$/, "") === "/404";
const canonical = new URL(
  is404 ? "/404.html" : Astro.url.pathname,
  siteConfig.url,
).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {is404 && <meta name="robots" content="noindex" />}
    <link
      rel="preload"
      href="/fonts/inter-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        name: siteConfig.name,
        url: siteConfig.url,
        jobTitle: "Procurement & Supply Chain Leader",
        description: siteConfig.description,
        sameAs: [siteConfig.linkedin],
        image: `${siteConfig.url}/images/headshot.jpeg`,
        knowsAbout: [
          "Strategic sourcing",
          "Procurement transformation",
          "Capital benchmarking",
          "Category strategy",
          "Supplier governance",
        ],
        alumniOf: [
          {
            "@type": "CollegeOrUniversity",
            name: "University of Petroleum & Energy Studies",
          },
          { "@type": "CollegeOrUniversity", name: "Kumaun University" },
        ],
      }).replace(/</g, "\u003c")}
    ></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      Skip to main content
    </a>
    <slot />
  </body>
</html>
